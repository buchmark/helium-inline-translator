{
  "manifest_version": 3,
  "name": "Helium Inline Translator",
  "default_locale": "en",
  "version": "1.1.1",
  "description": "__MSG_appDesc__",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://edge.microsoft.com/translate/*",
    "https://translate.yandex.net/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "__MSG_contextTranslateSelection__"
    },
    "translate-page": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "__MSG_contextTranslatePage__"
    }
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
